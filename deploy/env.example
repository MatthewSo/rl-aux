# Copy to deploy/env and fill in. deploy/env is gitignored -- never commit it.
#
#   cp deploy/env.example deploy/env && $EDITOR deploy/env
#
# deploy/sync.sh and deploy/remote.sh source this automatically. Values can also
# be passed as flags or exported in your shell; flags win over env, env wins
# over this file.

# --- connection ------------------------------------------------------------
# From the vast.ai instance card ("Connect" gives you the ssh command).
# Example: ssh -p 41234 root@ssh5.vast.ai
VAST_HOST=root@ssh5.vast.ai
VAST_PORT=41234

# Or, if you prefer, define a Host block in ~/.ssh/config and set only this.
# An alias makes ControlMaster/keepalive settings reusable and keeps the port
# out of every command.
#   Host vast
#     HostName ssh5.vast.ai
#     User root
#     Port 41234
#     IdentityFile ~/.ssh/id_ed25519
#     ServerAliveInterval 30
# VAST_SSH_ALIAS=vast

# Private key used for the instance. Must be the key whose *public* half was
# pasted into the vast.ai account SSH-keys page before the instance was created.
SSH_KEY=~/.ssh/id_ed25519

# --- remote layout ---------------------------------------------------------
# /workspace is the mounted volume on most vast.ai templates; the container
# filesystem does not survive teardown.
WORKDIR=/workspace/rl-aux
REMOTE_RESULTS=/workspace/results
REMOTE_HF_HOME=/workspace/.cache/huggingface

# --- local layout ----------------------------------------------------------
# Where `sync.sh pull` deposits results. Gitignored.
LOCAL_ARTIFACTS=./vast_artifacts

# --- tokens ----------------------------------------------------------------
# Only needed to clone a private repo. setup.sh writes this to a repo-local
# .git-credentials rather than baking it into the remote URL, so it never
# appears in `git remote -v`, shell history, or CI logs.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Every model in the ladder is ungated, so this is optional. Set it if you hit
# hub rate limits from a shared datacenter IP, or if you add a gated model.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Weights & Biases, for `sweep.py --wandb`. From https://wandb.ai/authorize
# Optional: without it runs still write metrics.jsonl, and wandb records offline
# for you to `wandb sync` later. remote.sh forwards this to the box, and
# bootstrap will prompt for it if it isn't already set there.
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=wamal-lm
# Team name; leave unset to use your personal default entity.
# WANDB_ENTITY=your-team

# --- tuning ----------------------------------------------------------------
# Per-process BLAS/OpenMP cap. Rented containers get a slice of a large host but
# a small pid budget; uncapped OpenBLAS spawns one thread per host core and the
# container runs out of pids. Symptom is BrokenPipeError on dataloader fork.
WAMAL_NUM_THREADS=4
